local espEnabled = false
local espObjects = {}

local function getTeamColor(target)
	local team = target.Team

	if team then
		if team.Name == "Police" then
			return Color3.fromRGB(0, 100, 255)
		elseif team.Name == "Prisoner" then
			return Color3.fromRGB(255, 170, 0)
		elseif team.Name == "Criminal" then
			return Color3.fromRGB(255, 0, 0)
		end
	end

	return Color3.fromRGB(255, 255, 255)
end

local function removeESP(target)
	if espObjects[target] then
		for _, object in ipairs(espObjects[target]) do
			if object then
				object:Destroy()
			end
		end

		espObjects[target] = nil
	end
end

local function addESP(target)
	if target == player or not espEnabled then
		return
	end

	removeESP(target)

	local character = target.Character

	if not character then
		return
	end

	local head = character:FindFirstChild("Head")

	if not head then
		return
	end

	local color = getTeamColor(target)
	local teamName = target.Team and target.Team.Name or "No Team"

	local highlight = Instance.new("Highlight")
	highlight.Name = "NOVA_ESP"
	highlight.Adornee = character
	highlight.FillColor = color
	highlight.OutlineColor = color
	highlight.FillTransparency = 0.5
	highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
	highlight.Parent = character

	local billboard = Instance.new("BillboardGui")
	billboard.Name = "NOVA_ESP"
	billboard.Adornee = head
	billboard.Size = UDim2.new(0, 200, 0, 40)
	billboard.StudsOffset = Vector3.new(0, 3, 0)
	billboard.AlwaysOnTop = true
	billboard.Parent = head

	local label = Instance.new("TextLabel")
	label.Size = UDim2.new(1, 0, 1, 0)
	label.BackgroundTransparency = 1
	label.Text = target.Name .. " [" .. teamName .. "]"
	label.TextColor3 = color
	label.TextScaled = true
	label.Font = Enum.Font.SourceSansBold
	label.TextStrokeTransparency = 0
	label.Parent = billboard

	espObjects[target] = {
		highlight,
		billboard
	}
end

local function refreshESP()
	for _, target in ipairs(Players:GetPlayers()) do
		if target ~= player then
			if espEnabled then
				addESP(target)
			else
				removeESP(target)
			end
		end
	end
end

espButton.Activated:Connect(function()
	espEnabled = not espEnabled

	if espEnabled then
		espButton.Text = "ESP: ON"
	else
		espButton.Text = "ESP: OFF"
	end

	refreshESP()
end)

local function setupPlayer(target)
	if target == player then
		return
	end

	target.CharacterAdded:Connect(function()
		task.wait(0.5)

		if espEnabled then
			addESP(target)
		end
	end)

	target:GetPropertyChangedSignal("Team"):Connect(function()
		if espEnabled then
			addESP(target)
		end
	end)
end

for _, target in ipairs(Players:GetPlayers()) do
	setupPlayer(target)
end

Players.PlayerAdded:Connect(function(target)
	setupPlayer(target)

	if espEnabled then
		task.wait(0.5)
		addESP(target)
	end
end)

Players.PlayerRemoving:Connect(function(target)
	removeESP(target)
end)
